{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/semantic.schema.json",
  "title": "SemanticDocument",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "source",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "layoutDocumentId"
      ],
      "properties": {
        "layoutDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "filePath": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageNumber",
          "sourceBlockId",
          "role",
          "text",
          "bbox",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "sourceBlockId": {
            "type": "string",
            "minLength": 1
          },
          "sourceBlockIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "headingLineCount": {
            "type": "integer",
            "minimum": 2
          },
          "paragraphGroupId": { "type": "string", "minLength": 1 },
          "continuesFrom": { "type": "string", "minLength": 1 },
          "listContinuationOf": { "type": "string", "minLength": 1 },
          "captionForId": { "type": "string", "minLength": 1 },
          "footnoteReferenceId": { "type": "string", "minLength": 1 },
          "asideAnchorId": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["Row", "Column", "Both"] },
          "formFieldIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "listMarker": {
            "type": "string",
            "minLength": 1
          },
          "regionId": {
            "type": "string",
            "minLength": 1
          },
          "rawText": {
            "type": "string"
          },
          "comparisonText": {
            "type": "string"
          },
          "textProvenance": {
            "enum": [
              "native",
              "ocr"
            ]
          },
          "referenceMarkers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "Document",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "P",
              "L",
              "LI",
              "Table",
              "TH",
              "TD",
              "Artifact"
            ]
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "items": false
          },
          "headingLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "direction": { "enum": ["ltr", "rtl"] },
          "listLevel": { "type": "integer", "minimum": 1, "maximum": 32 },
          "columnHint": {
            "type": "integer",
            "minimum": 0
          },
          "readingOrder": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "inferenceStatus": {
      "const": "uncalibrated-requires-review"
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "parentNodeId",
          "level",
          "evidence",
          "status"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "parentNodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "requires-review"
          }
        },
        "additionalProperties": false
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageNumber",
          "parentId",
          "kind",
          "nodeIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "page",
              "column",
              "spanning",
              "footnotes"
            ]
          },
          "nodeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tableFragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageNumber",
          "tableId",
          "nodeIds",
          "anchors",
          "headerSignature",
          "status",
          "continuesFrom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "tableId": {
            "type": "string",
            "minLength": 1
          },
          "nodeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "headerSignature": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "requires-review",
              "grid-checked",
              "continuation-proposed"
            ]
          },
          "continuesFrom": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageNumber",
          "bbox",
          "captionNodeIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "items": false
          },
          "captionNodeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "const": "requires-description-review"
          }
        },
        "additionalProperties": false
      }
    },
    "headingMergeSummary": {
      "type": "object",
      "required": ["mergedGroups", "absorbedLines"],
      "properties": {
        "mergedGroups": { "type": "integer", "minimum": 0 },
        "absorbedLines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "formRelationships": { "type": "array", "items": { "type": "object", "required": ["id", "widgets", "labels"], "properties": {
      "id": { "type": "string", "minLength": 1 }, "fieldType": { "type": "string" },
      "widgets": { "type": "array", "items": { "type": "object", "required": ["id", "pageNumber", "bbox"], "properties": {
        "id": { "type": "string", "minLength": 1 }, "pageNumber": { "type": "integer", "minimum": 1 },
        "appearanceText": { "type": "string", "minLength": 1, "maxLength": 160 },
        "appearanceTextSource": { "const": "normal-widget-appearance" },
        "authoredCaption": { "type": "string", "minLength": 1, "maxLength": 160 },
        "authoredCaptionSource": { "const": "widget-MK-CA" },
        "multiLine": { "type": "boolean" },
        "labelAssociation": { "type": "object", "required": ["kind", "evidence"], "properties": {
          "kind": { "enum": ["widget-appearance", "expanded-tooltip", "section-prompt", "compound-date"] },
          "evidence": { "type": "string", "minLength": 1 },
          "component": { "enum": ["day", "month", "year"] },
          "groupWidgetIds": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }, "allOf": [{ "if": { "properties": { "kind": { "const": "compound-date" } } },
          "then": { "required": ["component", "groupWidgetIds"] } }], "additionalProperties": false },
        "bbox": { "$ref": "#/properties/nodes/items/properties/bbox" }
      }, "additionalProperties": true } },
      "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    }, "additionalProperties": false } },
    "formNavigation": { "type": "object", "required": ["proposedWidgetOrder", "unresolvedWidgetIds", "status"], "properties": {
      "proposedWidgetOrder": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "unresolvedWidgetIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "status": { "const": "requires-reader-test" }
    }, "additionalProperties": false },
    "semanticReviewTasks": { "type": "array", "items": { "type": "object", "required": ["code"], "properties": {
      "code": { "type": "string", "minLength": 1 }, "pageNumber": { "type": "integer", "minimum": 1 },
      "nodeId": { "type": "string" }, "widgetId": { "type": "string" }, "relatedNodeId": { "type": "string" },
      "candidates": { "type": "array", "items": { "type": "string" } }
    }, "additionalProperties": false } },
    "relations": {
      "type": "array",
      "items": { "type": "object", "required": ["type", "from", "to", "evidence"], "properties": {
        "type": { "enum": ["precedes", "labels", "describes", "belongsToGroup", "continues", "captionFor", "headerFor"] },
        "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }, "additionalProperties": false }
    },
    "orderedNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
