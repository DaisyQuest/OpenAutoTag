{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/repair-audit.schema.json",
  "title": "Qualified structure repair audit",
  "type": "object", "required": ["sourceHash", "candidateHash", "repairLedger"],
  "properties": {
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repairLedger": { "type": "array", "items": { "type": "object",
      "required": ["ruleId", "version", "target", "decision", "reason"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 },
        "target": { "type": "string", "minLength": 1 }, "decision": { "enum": ["apply", "review"] },
        "reason": { "type": "string", "minLength": 1 }
      }, "additionalProperties": false
    } }
  }, "additionalProperties": false
}
