{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/tagging.schema.json",
  "title": "TaggingDocument",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "source",
    "root"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "semanticDocumentId"
      ],
      "properties": {
        "semanticDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "filePath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "root": {
      "$ref": "#/$defs/tagNode"
    },
    "ocrReview": {"type":"object","required":["review","reviewHash","documentHash"],"properties":{"review":{"type":"object","required":["schemaVersion","sourceHash","intentHash","reviewer","evidence","decisions"],"properties":{"schemaVersion":{"const":"1.0.0"},"sourceHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"intentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reviewer":{"type":"string","minLength":1,"maxLength":256},"evidence":{"type":"string","minLength":1,"maxLength":4096},"decisions":{"type":"array","minItems":1,"maxItems":100000,"items":{"type":"object","required":["tagId","segmentIndex","pageNumber","sourceBlockId","expectedText","text","decision"],"properties":{"tagId":{"type":"string","minLength":1,"maxLength":32768},"segmentIndex":{"type":"integer","minimum":0,"maximum":32768},"pageNumber":{"type":"integer","minimum":1},"sourceBlockId":{"type":"string","minLength":1,"maxLength":32768},"expectedText":{"type":"string","minLength":1,"maxLength":32768},"text":{"type":"string","minLength":1,"maxLength":32768},"decision":{"enum":["confirm","correct"]}},"additionalProperties":false}}},"additionalProperties":false},"reviewHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"documentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},
    "fontInventoryRef": {
      "type": "string",
      "description": "Optional path (relative to job workspace) to a font-inventory.schema.json document produced by the font-embedder stage. When present, pdf-writer MUST honor its plan[] entries."
    }
  },
  "$defs": {
    "tableGridReview": {"type":"object","required":["algorithm","status","tableId","issues"],"properties":{"algorithm":{"const":"declared-grid-v1"},"status":{"const":"review_required"},"tableId":{"type":"string","minLength":1},"issues":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","required":["code","cellId","message"],"properties":{"code":{"enum":["GRID_LIMIT","INVALID_ROW","INVALID_SPAN","INVALID_COLUMN","ROW_SPAN_GAP","OVERLAPPING_SPANS"]},"cellId":{"type":"string","minLength":1},"conflictingCellId":{"type":"string","minLength":1},"message":{"type":"string","minLength":1,"maxLength":1024}},"additionalProperties":false}}},"additionalProperties":false},
    "tagNode": {
      "type": "object",
      "required": [
        "id",
        "type",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "Document",
            "Sect",
            "Title",
            "H1",
            "H2",
            "H3",
            "H4",
            "H5",
            "H6",
            "P",
            "L",
            "LI",
            "Lbl",
            "LBody",
            "Caption",
            "Figure",
            "Aside",
            "BlockQuote",
            "Span",
            "Link",
            "Form",
            "Table",
            "THead",
            "TBody",
            "TFoot",
            "TR",
            "TH",
            "TD"
          ]
        },
        "label": {
          "type": "string"
        },
        "ocrSegments": {
          "description": "Declared invisible OCR text in display points, bound by the tagging intent hash. Each entry must have its own saved marked-content sequence and this tag as its owner; font changes may use multiple text operators. Transcription and reading order still require review.",
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": {
            "type": "object", "required": ["pageNumber", "sourceBlockId", "text", "quad"],
            "properties": {
              "pageNumber": { "type": "integer", "minimum": 1 },
              "sourceBlockId": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1, "maxLength": 32768 },
              "quad": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "number" } },
              "recognition": {"type":"object","required":["originalText","range","alignment","words"],"properties":{"originalText":{"type":"string","minLength":1,"maxLength":32768},"range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0,"maximum":32768}},"alignment":{"enum":["complete","unresolved","unavailable"]},"words":{"type":"array","minItems":0,"maxItems":4096,"items":{"type":"object","required":["text","geometryStatus"],"properties":{"text":{"type":"string","minLength":1,"maxLength":4096},"start":{"type":"integer","minimum":0,"maximum":32768},"end":{"type":"integer","minimum":0,"maximum":32768},"confidence":{"type":"number","minimum":0,"maximum":100},"quad":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"number"}},"geometryStatus":{"enum":["mapped","clipped","unavailable"]}},"additionalProperties":false}}},"additionalProperties":false,"description":"Immutable normalized recognizer text and word evidence. Offsets and range are UTF-16 positions in originalText; confidence is uncalibrated and never constitutes review. Range selects a list label/body fragment; word geometry does not control the generated line geometry."},
              "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
            }, "additionalProperties": false
          }
        },
        "nativeWidget": {"type":"object","required":["widgetId","sourceRef","pageNumber","fieldName","placement","anchorNodeIds"],"properties":{"widgetId":{"type":"string","minLength":1},"sourceRef":{"type":"string","pattern":"^[1-9][0-9]* [0-9]+ R$"},"pageNumber":{"type":"integer","minimum":1},"fieldName":{"type":"string"},"placement":{"enum":["label-context","unresolved"]},"anchorNodeIds":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
        "nativeFigure": {"type": "object", "required": ["pageNumber", "bbox", "sourceId"], "properties": {"pageNumber": {"type": "integer", "minimum": 1}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "sourceId": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "captionAssociation": {"type": "object", "required": ["targetId", "targetType", "position", "evidence"], "properties": {"targetId": {"type": "string", "minLength": 1}, "targetType": {"enum": ["Figure", "Table"]}, "position": {"enum": ["before", "after"]}, "evidence": {"enum": ["explicit-target-and-geometry", "adjacent-table-and-geometry"]}}, "additionalProperties": false},
        "tableGridReview": { "$ref": "#/$defs/tableGridReview" },
        "mergedCellIds": { "type": "array", "minItems": 2, "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tableRowOrigin": {"type":"object","required":["pageNumber","rowIndex"],"properties":{"pageNumber":{"type":"integer","minimum":1},"rowIndex":{"type":"integer","minimum":0}},"additionalProperties":false},
        "tableSectionOrigin": {"enum":["head","foot"]},
        "repeatedHeaderOf": {"type":"string","minLength":1},
        "tableHeaderEvidence": {"type":"object","required":["algorithm","columnHeaders","rowHeaders"],"properties":{"algorithm":{"const":"directional-grid-v1"},"scopeSource":{"enum":["explicit","thead","body-default","continued-head"]},"columnHeaders":{"type":"array","maxItems":10000,"uniqueItems":true,"items":{"type":"string","minLength":1}},"rowHeaders":{"type":"array","maxItems":10000,"uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
        "headerId": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["Row", "Column", "Both"] },
        "listNumbering": { "enum": ["None", "Disc", "Circle", "Square", "Decimal", "UpperRoman", "LowerRoman", "UpperAlpha", "LowerAlpha"] },
        "sourceNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tagNode"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
