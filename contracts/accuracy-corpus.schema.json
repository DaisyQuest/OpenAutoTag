{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/accuracy-corpus.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "holdoutState",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "holdoutState": {
      "enum": [
        "candidate-unreviewed",
        "frozen"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "lineage",
          "split",
          "priority",
          "features",
          "provenance",
          "review",
          "expectations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lineage": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "holdout"
            ]
          },
          "priority": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "adjudicated"
                ]
              },
              "reviewers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "adjudicator": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rule",
                "kind",
                "source",
                "expected"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "role",
                    "label",
                    "precedence",
                    "paragraph",
                    "header"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "role"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "label",
                          "precedence",
                          "paragraph",
                          "header"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "target"
                    ]
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
