{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/layout.schema.json",
  "title": "LayoutDocument",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "source",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "filePath"
      ],
      "properties": {
        "coordinateSpace": {
          "const": "crop-display-points",
          "description": "Page dimensions, font sizes and content/widget boxes use physical points (1/72 inch), relative to the displayed CropBox top-left after Rotate and UserUnit. The cropBox metadata retains raw PDF coordinates. Absence denotes legacy unrotated coordinates."
        },
        "filePath": {
          "type": "string",
          "minLength": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pageNumber",
          "width",
          "height",
          "textBlocks"
        ],
        "properties": {
          "cropBox": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"},"description":"Visible page bounds in original PDF user coordinates, before rotation and UserUnit."},
          "rotation": {"enum":[0,90,180,270]},
          "userUnit": {"type":"number","exclusiveMinimum":0},
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "bbox",
                "source",
                "operatorIndex"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ],
                  "items": false
                },
                "source": {
                  "const": "image-operator"
                },
                "operatorIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "imageEvidenceError": {
            "type": "string"
          },
          "diagramRegions": {"type":"array","maxItems":256,"items":{"type":"object","required":["id","bbox","titleBlockId","blockIds","evidence","status"],"properties":{"id":{"type":"string","minLength":1},"bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},"titleBlockId":{"type":"string","minLength":1},"blockIds":{"type":"array","minItems":6,"maxItems":4096,"uniqueItems":true,"items":{"type":"string","minLength":1}},"figureId":{"type":"string","minLength":1},"evidence":{"enum":["image-with-diagram-title","connectors-with-diagram-title"]},"status":{"const":"review_required"}},"additionalProperties":false}},
          "columns": {
            "type": "integer",
            "minimum": 1
          },
          "textBlocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "bbox",
                "fontSize"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "diagramRegionId": {"type":"string","minLength":1},
                "rawText": {
                  "type": "string"
                },
                "comparisonText": {
                  "type": "string"
                },
                "textProvenance": {
                  "enum": [
                    "native",
                    "ocr"
                  ]
                },
                "ocrRecognition": {"type":"object","required":["originalText","range","alignment","words"],"properties":{"originalText":{"type":"string","minLength":1,"maxLength":32768},"range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0,"maximum":32768}},"alignment":{"enum":["complete","unresolved","unavailable"]},"words":{"type":"array","minItems":0,"maxItems":4096,"items":{"type":"object","required":["text","geometryStatus"],"properties":{"text":{"type":"string","minLength":1,"maxLength":4096},"start":{"type":"integer","minimum":0,"maximum":32768},"end":{"type":"integer","minimum":0,"maximum":32768},"confidence":{"type":"number","minimum":0,"maximum":100},"quad":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"number"}},"geometryStatus":{"enum":["mapped","clipped","unavailable"]}},"additionalProperties":false}}},"additionalProperties":false,"description":"Immutable normalized recognizer text and word evidence. Offsets and range are UTF-16 positions in originalText; confidence is uncalibrated and never constitutes review. Range selects a list label/body fragment; word geometry does not control the generated line geometry."},
                "ocrGeometry": {
                  "type": "object",
                  "description": "Recognition pixel coordinates mapped once into the displayed CropBox, including inverse recognizer deskew. This is geometry evidence, not text accuracy or acceptance.",
                  "required": ["coordinateSpace", "imageSize", "recognitionRotationRadians", "pixelBox", "pixelToDisplay", "quad", "clipped"],
                  "properties": {
                    "coordinateSpace": { "const": "crop-display-points" },
                    "imageSize": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
                    "recognitionRotationRadians": { "type": "number", "minimum": -3.141593, "maximum": 3.141593 },
                    "pixelBox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } },
                    "pixelToDisplay": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
                    "quad": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "number" } },
                    "clipped": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "referenceMarkers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ],
                  "items": false
                },
                "fontSize": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "fontName": {
                  "type": "string"
                },
                "direction": { "enum": ["ltr", "rtl"] },
                "captionForId": { "type": "string", "minLength": 1 },
                "footnoteReferenceId": { "type": "string", "minLength": 1 },
                "asideAnchorId": { "type": "string", "minLength": 1 },
                "scope": { "enum": ["Row", "Column", "Both"] },
                "formFieldIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "blockType": {
                  "type": "string",
                  "enum": [
                    "heading",
                    "paragraph",
                    "list-item",
                    "table-cell",
                    "unknown"
                  ]
                },
                "headingLevel": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "columnHint": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          },
          "captionEvidenceError": { "type": "string", "minLength": 1 },
          "formFields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "bbox"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "widgetId": { "type": "string", "minLength": 1 },
                "fieldId": { "type": "string", "minLength": 1 },
                "radioButton": { "type": "boolean" },
                "checkBox": { "type": "boolean" },
                "readOnly": { "type": "boolean" },
                "required": { "type": "boolean" },
                "fieldName": { "type": "string" },
                "fieldType": { "type": "string" },
                "tooltip": { "type": "string" },
                "fieldRef": { "type": "string", "pattern": "^[1-9][0-9]* [0-9]+ R$" },
                "tooltipOwnerRef": { "type": "string", "pattern": "^[1-9][0-9]* [0-9]+ R$" },
                "tooltipSource": { "enum": ["widget-TU", "field-TU"] },
                "choiceControl": {"type":"object","additionalProperties":false,"required":["kind","fieldRef","groupName","flags","widgetCount","widgetIndex","stateIssues"],"properties":{"kind":{"enum":["radio","choice"]},"fieldRef":{"type":"string","pattern":"^[1-9][0-9]* [0-9]+ R$"},"groupName":{"type":"string","maxLength":4096},"flags":{"type":"integer","minimum":0,"maximum":2147483647},"widgetCount":{"type":"integer","minimum":1,"maximum":1024},"widgetIndex":{"type":"integer","minimum":0,"maximum":1023},"stateIssues":{"type":"array","uniqueItems":true,"items":{"enum":["MISSING_APPEARANCE_STATE","UNKNOWN_APPEARANCE_STATE","UNKNOWN_GROUP_VALUE","VALUE_APPEARANCE_MISMATCH","MULTIPLE_RADIO_SELECTIONS","UNISON_STATE_MISMATCH","VALUE_INDEX_MISMATCH","AMBIGUOUS_EXPORT_VALUE","UNKNOWN_CHOICE_VALUE","MULTIPLE_SINGLE_CHOICE_VALUES"]}},"onState":{"type":"string","minLength":1,"maxLength":256},"appearanceState":{"type":"string","minLength":1,"maxLength":256},"value":{"type":"string","minLength":1,"maxLength":256},"exportValue":{"type":"string","maxLength":4096},"exportSource":{"enum":["Opt","AP-N"]},"selected":{"type":"boolean"},"options":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["exportValue","displayValue"],"properties":{"exportValue":{"type":"string","maxLength":4096},"displayValue":{"type":"string","maxLength":4096}}}},"values":{"type":"array","maxItems":4096,"items":{"type":"string","maxLength":4096}},"selectedIndices":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":4095}}},"oneOf":[{"properties":{"kind":{"const":"radio"},"options":false,"values":false,"selectedIndices":false},"required":["onState","appearanceState","value","exportValue","exportSource","selected"]},{"properties":{"kind":{"const":"choice"},"onState":false,"appearanceState":false,"value":false,"exportValue":false,"exportSource":false,"selected":false},"required":["options","values","selectedIndices"]}]},
                "choiceMetadataError": {"type":"string","minLength":1,"maxLength":256},
                "pushButton": { "type": "boolean" },
                "multiLine": { "type": "boolean" },
                "appearanceText": { "type": "string", "minLength": 1, "maxLength": 160 },
                "appearanceTextSource": { "const": "normal-widget-appearance" },
                "authoredCaption": { "type": "string", "minLength": 1, "maxLength": 160 },
                "authoredCaptionSource": { "const": "widget-MK-CA" },
                "bbox": { "$ref": "#/properties/pages/items/properties/textBlocks/items/properties/bbox" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
