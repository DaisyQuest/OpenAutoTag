{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/layout.schema.json",
  "title": "LayoutDocument",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "source",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "filePath"
      ],
      "properties": {
        "coordinateSpace": {
          "const": "crop-display-points",
          "description": "Page dimensions, font sizes and content/widget boxes use physical points (1/72 inch), relative to the displayed CropBox top-left after Rotate and UserUnit. The cropBox metadata retains raw PDF coordinates. Absence denotes legacy unrotated coordinates."
        },
        "filePath": {
          "type": "string",
          "minLength": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pageNumber",
          "width",
          "height",
          "textBlocks"
        ],
        "properties": {
          "cropBox": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"},"description":"Visible page bounds in original PDF user coordinates, before rotation and UserUnit."},
          "rotation": {"enum":[0,90,180,270]},
          "userUnit": {"type":"number","exclusiveMinimum":0},
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "bbox",
                "source",
                "operatorIndex"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ],
                  "items": false
                },
                "source": {
                  "const": "image-operator"
                },
                "operatorIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "imageEvidenceError": {
            "type": "string"
          },
          "columns": {
            "type": "integer",
            "minimum": 1
          },
          "textBlocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "bbox",
                "fontSize"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "rawText": {
                  "type": "string"
                },
                "comparisonText": {
                  "type": "string"
                },
                "textProvenance": {
                  "enum": [
                    "native",
                    "ocr"
                  ]
                },
                "referenceMarkers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ],
                  "items": false
                },
                "fontSize": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "fontName": {
                  "type": "string"
                },
                "direction": { "enum": ["ltr", "rtl"] },
                "captionForId": { "type": "string", "minLength": 1 },
                "footnoteReferenceId": { "type": "string", "minLength": 1 },
                "asideAnchorId": { "type": "string", "minLength": 1 },
                "scope": { "enum": ["Row", "Column", "Both"] },
                "formFieldIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "blockType": {
                  "type": "string",
                  "enum": [
                    "heading",
                    "paragraph",
                    "list-item",
                    "table-cell",
                    "unknown"
                  ]
                },
                "headingLevel": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "columnHint": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          },
          "captionEvidenceError": { "type": "string", "minLength": 1 },
          "formFields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "bbox"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "widgetId": { "type": "string", "minLength": 1 },
                "fieldId": { "type": "string", "minLength": 1 },
                "radioButton": { "type": "boolean" },
                "checkBox": { "type": "boolean" },
                "readOnly": { "type": "boolean" },
                "required": { "type": "boolean" },
                "fieldName": { "type": "string" },
                "fieldType": { "type": "string" },
                "tooltip": { "type": "string" },
                "pushButton": { "type": "boolean" },
                "multiLine": { "type": "boolean" },
                "appearanceText": { "type": "string", "minLength": 1, "maxLength": 160 },
                "appearanceTextSource": { "const": "normal-widget-appearance" },
                "authoredCaption": { "type": "string", "minLength": 1, "maxLength": 160 },
                "authoredCaptionSource": { "const": "widget-MK-CA" },
                "bbox": { "$ref": "#/properties/pages/items/properties/textBlocks/items/properties/bbox" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
