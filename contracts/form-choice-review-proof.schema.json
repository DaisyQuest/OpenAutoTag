{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.local/contracts/form-choice-review-proof.schema.json",
 "title":"Attribution for a reviewed semantic choice document","type":"object","additionalProperties":false,
 "required":["schemaVersion","sourceHash","originalIntentHash","reviewHash","contentHash","reviewer","evidence","fieldRefs"],
 "properties":{
  "schemaVersion":{"const":"1.0.0"},"sourceHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"originalIntentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reviewHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reviewer":{"type":"string","minLength":1,"maxLength":256},"evidence":{"type":"string","minLength":1,"maxLength":4096},"fieldRefs":{"type":"array","minItems":1,"maxItems":1024,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]* [0-9]+ R$"}}
 }
}
