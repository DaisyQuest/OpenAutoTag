{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/source-ownership.schema.json",
  "title": "Native source glyph ownership intent",
  "description": "Writer-proposed source ranges, independently verified against source and saved content. This is not proof of semantic classification accuracy.",
  "type": "object", "required": ["schemaVersion", "sourceHash", "intentHash", "ranges"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nativeFigures": {"type":"array","maxItems":10000,"items":{"type":"object","required":["tagNodeId","pageNumber","streamOrigin","operatorIndex"],"properties":{"tagNodeId":{"type":"string","minLength":1},"pageNumber":{"type":"integer","minimum":1},"streamOrigin":{"type":"string","pattern":"^page(?:/[0-9]+)*$"},"operatorIndex":{"type":"integer","minimum":0}},"additionalProperties":false}},
    "nativeLinks": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/nativeLink" } },
    "ranges": { "type": "array", "maxItems": 100000, "items": {
      "type": "object", "required": ["pageNumber", "streamOrigin", "operatorIndex", "glyphStart", "glyphEnd", "tagNodeId"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "streamOrigin": { "type": "string", "pattern": "^page(?:/[0-9]+)*$" },
        "operatorIndex": { "type": "integer", "minimum": 0 },
        "glyphStart": { "type": "integer", "minimum": 0 }, "glyphEnd": { "type": "integer", "minimum": 1 },
        "tagNodeId": { "type": "string", "minLength": 1 }
      }, "additionalProperties": false
    } }
  },
  "$defs": {
    "nativeLink": {
      "type": "object", "required": ["pageNumber", "annotationIndex", "sourceAnnotationRef", "status", "reason"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 }, "annotationIndex": { "type": "integer", "minimum": 0 },
        "sourceAnnotationRef": { "type": "string", "minLength": 1 },
        "status": { "enum": ["bound", "review_required"] }, "reason": { "type": "string", "minLength": 1 },
        "ownerTagId": { "type": "string", "minLength": 1 }, "anchorText": { "type": "string", "minLength": 1 },
        "groupedOwnerTagIds": { "type": "array", "minItems": 2, "maxItems": 4096, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Complete consecutive Span siblings under ownerTagId, in intended logical order. Original source ownership and semantic IDs remain unchanged." },
        "linkStructureId": { "type": "string", "minLength": 1 }, "parentTreeKey": { "type": "integer", "minimum": 0 },
        "suppressedRedundantActualText": { "const": true, "description": "Only a generated leaf replacement exactly equal to the complete source glyph text may be omitted; the saved validator independently verifies this claim." },
        "ranges": { "type": "array", "minItems": 1, "maxItems": 100000, "items": {
          "type": "object", "required": ["streamOrigin", "operatorIndex", "glyphStart", "glyphEnd"],
          "properties": { "streamOrigin": { "type": "string", "pattern": "^page(?:/[0-9]+)*$" }, "operatorIndex": { "type": "integer", "minimum": 0 }, "glyphStart": { "type": "integer", "minimum": 0 }, "glyphEnd": { "type": "integer", "minimum": 1 } }, "additionalProperties": false
        } }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "bound" } } }, "then": { "required": ["ownerTagId", "anchorText", "linkStructureId", "parentTreeKey", "ranges"] } }, { "if": { "required": ["groupedOwnerTagIds"] }, "then": { "not": { "required": ["suppressedRedundantActualText"] } } }],
      "additionalProperties": false
    }
  }, "additionalProperties": false
}
