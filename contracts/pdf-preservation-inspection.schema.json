{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/pdf-preservation-inspection.schema.json",
  "title": "PDF preservation inspection",
  "type": "object",
  "required": ["schemaVersion", "scope", "sourceHash", "pages", "fields", "widgets", "headings", "issues", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scope": { "const": "preserved-objects-v1" },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "navigation": { "$ref": "#/$defs/navigation" },
    "imageRuns": {"type":"array","maxItems":100000,"items":{"type":"object","required":["pageNumber","streamOrigin","operatorIndex","imageSha256","appearanceHash","width","height","bitsPerComponent","bbox","matrix","owners","artifact"],"properties":{"pageNumber":{"type":"integer","minimum":1},"streamOrigin":{"type":"string","pattern":"^page(?:/[0-9]+)*$"},"operatorIndex":{"type":"integer","minimum":0},"imageSha256":{"$ref":"#/$defs/hash"},"appearanceHash":{"$ref":"#/$defs/hash"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"bitsPerComponent":{"type":"integer","minimum":-1},"matrix":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"number"}},"bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},"owners":{"type":"array","items":{"type":"string"},"uniqueItems":true},"artifact":{"type":"boolean"}},"additionalProperties":false}},
    "textRuns": {
      "type": "array", "maxItems": 100000, "items": {
        "type": "object", "required": ["pageNumber", "streamOrigin", "operatorIndex", "glyphStart", "glyphEnd", "owners", "artifact", "fontName", "glyphs", "positions"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 }, "streamOrigin": { "type": "string", "pattern": "^page(?:/[0-9]+)*$" },
          "operatorIndex": { "type": "integer", "minimum": 0 }, "glyphStart": { "type": "integer", "minimum": 0 }, "glyphEnd": { "type": "integer", "minimum": 0 },
          "owners": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "artifact": { "type": "boolean" }, "fontName": { "type": "string" },
          "fontEmbedded": { "type": "boolean" },
          "glyphProgramsPresent": { "type": "boolean", "description": "Every decoded character code resolves to a glyph in a supported vector font. False also covers unavailable or unsupported font-program inspection." },
          "renderingMode": { "type": "integer", "minimum": 0, "maximum": 7 },
          "positions": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 8, "maxItems": 8 } },
          "glyphs": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "string" }], "minItems": 2, "maxItems": 2 } }
        }, "additionalProperties": false
      }
    },
    "replacementScopes": {
      "type": "array", "maxItems": 100000, "items": {
        "type": "object", "required": ["pageNumber", "glyphStart", "glyphEnd", "text", "outermost"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 }, "glyphStart": { "type": "integer", "minimum": 0 }, "glyphEnd": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" }, "outermost": { "type": "boolean" }
        }, "additionalProperties": false
      }
    },
    "markedContent": {
      "description": "Saved executed page/Form sequences, independently parsed from content streams; counts exclude Artifact paint and ignore replacement text.",
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["contentRef", "sequenceCount", "glyphCount", "meaningfulGlyphCount", "unknownGlyphCount", "graphicsCount"],
        "properties": {
          "contentRef": { "type": "string", "minLength": 1 },
          "sequenceCount": { "type": "integer", "minimum": 1 },
          "glyphCount": { "type": "integer", "minimum": 0 },
          "meaningfulGlyphCount": { "type": "integer", "minimum": 0 },
          "unknownGlyphCount": { "type": "integer", "minimum": 0 },
          "graphicsCount": { "type": "integer", "minimum": 0 }
        }, "additionalProperties": false
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objectRef",
          "parentRef",
          "role",
          "identifier",
          "page",
          "children",
          "contentRefs",
          "headers",
          "scope",
          "listNumbering",
          "rowSpan",
          "columnSpan",
          "actualText",
          "alt"
        ],
        "properties": {
          "objectRef": {
            "type": "string"
          },
          "parentRef": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "listNumbering": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rowSpan": {
            "type": "integer"
          },
          "columnSpan": {
            "type": "integer"
          },
          "actualText": {
            "type": "string"
          },
          "actualTextPresent": { "type": "boolean" },
          "alt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "contentOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
    "widgets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/widget" } },
    "links": { "type": "object", "additionalProperties": { "type": "object", "required": ["digest", "page", "uri", "contents", "owners"], "properties": {
      "digest": { "$ref": "#/$defs/hash" }, "page": { "type": "integer", "minimum": 1 },
      "uri": { "type": "string" }, "contents": { "type": "string" }, "owners": { "type": "array", "items": { "type": "string" } },
      "annotationIndex": { "type": "integer", "minimum": 0 }, "structParent": { "type": "integer", "minimum": -1 }, "nativeDigest": { "$ref": "#/$defs/hash" },
      "rectangle": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
      "visible": { "type": "boolean" }, "quadPointsPresent": { "type": "boolean" },
      "linkPathPresent": { "type": "boolean" }, "quadPoints": { "type": ["array", "null"], "maxItems": 8192, "items": { "type": "number" } }
    }, "additionalProperties": false } },
    "headings": { "type": "array", "items": { "type": "object", "required": ["id", "role", "contentRefs"], "properties": {
      "id": { "type": "string" }, "role": { "type": "string", "pattern": "^H[1-6]$" },
      "contentRefs": { "type": "array", "items": { "type": "string" } }
    }, "additionalProperties": false } },
    "issues": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "navigation": {"type":"object","required":["pageLabels","outlines","namedDestinationsHash","issues"],"properties":{"pageLabels":{"type":"object","required":["present","treeHash","ranges","labels"],"properties":{"present":{"type":"boolean"},"treeHash":{"$ref":"#/$defs/hash"},"ranges":{"type":"array","maxItems":100000,"items":{"type":"object","required":["index","style","prefix","start","propertiesHash"],"properties":{"index":{"type":"integer","minimum":0},"style":{"enum":["","D","R","r","A","a"]},"prefix":{"type":"string"},"start":{"type":"integer","minimum":1},"propertiesHash":{"$ref":"#/$defs/hash"}},"additionalProperties":false}},"labels":{"type":"array","maxItems":100000,"items":{"type":"string"}}},"additionalProperties":false},"outlines":{"type":"object","required":["present","count","propertiesHash","items","graphHash"],"properties":{"present":{"type":"boolean"},"count":{"type":"integer"},"propertiesHash":{"$ref":"#/$defs/hash"},"items":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/outlineItem"}},"graphHash":{"$ref":"#/$defs/hash"}},"additionalProperties":false},"namedDestinationsHash":{"$ref":"#/$defs/hash"},"issues":{"type":"array","maxItems":100000,"items":{"type":"string"}}},"additionalProperties":false},
    "outlineItem": {"type":"object","required":["title","count","propertiesHash","destination","children"],"properties":{"title":{"type":"string"},"count":{"type":"integer"},"propertiesHash":{"$ref":"#/$defs/hash"},"destination":{"oneOf":[{"type":"object","required":["kind"],"properties":{"kind":{"const":"none"}},"additionalProperties":false},{"type":"object","required":["kind","name","pageNumber","fit","values"],"properties":{"kind":{"const":"local"},"name":{"type":"string"},"pageNumber":{"type":"integer","minimum":1},"fit":{"enum":["Fit","FitB","FitH","FitV","FitBH","FitBV","XYZ","FitR"]},"values":{"type":"array","maxItems":100000,"items":{"type":["number","null"]}}},"additionalProperties":false}]},"children":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/outlineItem"}}},"additionalProperties":false},
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "page": { "type": "object", "required": ["geometry", "contentHash", "resourcesHash", "annotationsHash"], "properties": {
      "geometry": { "type": "array", "items": { "type": "number" }, "minItems": 10, "maxItems": 10 },
      "contentHash": { "$ref": "#/$defs/hash" }, "resourcesHash": { "$ref": "#/$defs/hash" }, "annotationsHash": { "$ref": "#/$defs/hash" }
    }, "additionalProperties": false },
    "widget": { "type": "object", "required": ["digest", "page", "owners"], "properties": {
      "digest": { "$ref": "#/$defs/hash" }, "page": { "type": "integer", "minimum": 1 },
      "annotationIndex":{"type":"integer","minimum":0},"structParent":{"type":"integer","minimum":-1},"nativeDigest":{"$ref":"#/$defs/hash"},"appearanceHash":{"type":"string"},"fieldName":{"type":"string"},"fieldStateHash":{"$ref":"#/$defs/hash"},"accessibleName":{"type":"string"},"choiceMetadataError":{"type":"string","minLength":1,"maxLength":256},
      "choiceControl":{"type":"object","additionalProperties":false,"required":["kind","fieldRef","groupName","flags","widgetCount","widgetIndex","stateIssues"],"properties":{"kind":{"enum":["radio","choice"]},"fieldRef":{"type":"string","pattern":"^[1-9][0-9]* [0-9]+ R$"},"groupName":{"type":"string","maxLength":4096},"flags":{"type":"integer","minimum":0,"maximum":2147483647},"widgetCount":{"type":"integer","minimum":1,"maximum":1024},"widgetIndex":{"type":"integer","minimum":0,"maximum":1023},"stateIssues":{"type":"array","uniqueItems":true,"items":{"enum":["MISSING_APPEARANCE_STATE","UNKNOWN_APPEARANCE_STATE","UNKNOWN_GROUP_VALUE","VALUE_APPEARANCE_MISMATCH","MULTIPLE_RADIO_SELECTIONS","UNISON_STATE_MISMATCH","VALUE_INDEX_MISMATCH","AMBIGUOUS_EXPORT_VALUE","UNKNOWN_CHOICE_VALUE","MULTIPLE_SINGLE_CHOICE_VALUES"]}},"onState":{"type":"string","minLength":1,"maxLength":256},"appearanceState":{"type":"string","minLength":1,"maxLength":256},"value":{"type":"string","minLength":1,"maxLength":256},"exportValue":{"type":"string","maxLength":4096},"exportSource":{"enum":["Opt","AP-N"]},"selected":{"type":"boolean"},"options":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["exportValue","displayValue"],"properties":{"exportValue":{"type":"string","maxLength":4096},"displayValue":{"type":"string","maxLength":4096}}}},"values":{"type":"array","maxItems":4096,"items":{"type":"string","maxLength":4096}},"selectedIndices":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":4095}}},"oneOf":[{"properties":{"kind":{"const":"radio"},"options":false,"values":false,"selectedIndices":false},"required":["onState","appearanceState","value","exportValue","exportSource","selected"]},{"properties":{"kind":{"const":"choice"},"onState":false,"appearanceState":false,"value":false,"exportValue":false,"exportSource":false,"selected":false},"required":["options","values","selectedIndices"]}]},
      "owners": { "type": "array", "items": { "type": "object", "required": ["form", "listItem", "inBody"], "properties": {
        "form": { "type": "string" }, "listItem": { "type": "string" }, "inBody": { "type": "boolean" }
      }, "additionalProperties": false } }
    }, "additionalProperties": false }
  },
  "additionalProperties": false
}
