{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.local/contracts/form-choice.schema.json",
  "title":"Source radio and choice semantics without native value changes",
  "type":"object","additionalProperties":false,
  "required":["kind","fieldRef","groupName","flags","widgetCount","widgetIndex","stateIssues"],
  "properties":{
    "kind":{"enum":["radio","choice"]},"fieldRef":{"type":"string","pattern":"^[1-9][0-9]* [0-9]+ R$"},
    "groupName":{"type":"string","maxLength":4096},"flags":{"type":"integer","minimum":0,"maximum":2147483647},
    "widgetCount":{"type":"integer","minimum":1,"maximum":1024},"widgetIndex":{"type":"integer","minimum":0,"maximum":1023},
    "stateIssues":{"type":"array","uniqueItems":true,"items":{"enum":["MISSING_APPEARANCE_STATE","UNKNOWN_APPEARANCE_STATE","UNKNOWN_GROUP_VALUE","VALUE_APPEARANCE_MISMATCH","MULTIPLE_RADIO_SELECTIONS","UNISON_STATE_MISMATCH","VALUE_INDEX_MISMATCH","AMBIGUOUS_EXPORT_VALUE","UNKNOWN_CHOICE_VALUE","MULTIPLE_SINGLE_CHOICE_VALUES"]}},
    "onState":{"type":"string","minLength":1,"maxLength":256},"appearanceState":{"type":"string","minLength":1,"maxLength":256},"value":{"type":"string","minLength":1,"maxLength":256},
    "exportValue":{"type":"string","maxLength":4096},"exportSource":{"enum":["Opt","AP-N"]},"selected":{"type":"boolean"},
    "options":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["exportValue","displayValue"],"properties":{"exportValue":{"type":"string","maxLength":4096},"displayValue":{"type":"string","maxLength":4096}}}},
    "values":{"type":"array","maxItems":4096,"items":{"type":"string","maxLength":4096}},
    "selectedIndices":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":4095}}
  },
  "oneOf":[
    {"properties":{"kind":{"const":"radio"},"options":false,"values":false,"selectedIndices":false},"required":["onState","appearanceState","value","exportValue","exportSource","selected"]},
    {"properties":{"kind":{"const":"choice"},"onState":false,"appearanceState":false,"value":false,"exportValue":false,"exportSource":false,"selected":false},"required":["options","values","selectedIndices"]}
  ]
}
